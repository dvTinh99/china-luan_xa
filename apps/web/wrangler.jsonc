{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "linguaworld",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
}
