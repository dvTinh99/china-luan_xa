# LinguaWorld Environment Variables Template

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/linguaworld?schema=public"

# Auth Session Secret (minimum 32 characters)
SESSION_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"

# Game Host Origin for Iframe Bridge postMessage validation
NUXT_PUBLIC_GAME_ORIGIN="http://localhost:3000"
