// ============================================================================
// LinguaWorld — Prisma Schema (Phase 1: Learning Core)
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. User & Authentication
// ---------------------------------------------------------------------------
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessions           Session[]
  settings           UserSettings?
  character          Character?
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  learningSessions   LearningSession[]
  learningAnswers    LearningAnswer[]
  vocabularyProgress VocabularyProgress[]
  reviewHistory      ReviewHistory[]
  inventoryItems     InventoryItem[]
  userQuests         UserQuest[]
  combatSessions     CombatSession[]
  chakraProgress     UserChakraProgress[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  targetDailyReviews Int      @default(20) @map("target_daily_reviews")
  soundEnabled       Boolean  @default(true) @map("sound_enabled")
  pinyinDisplay      Boolean  @default(true) @map("pinyin_display")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------------------
// 2. Character & Progression (Separate from language proficiency)
// ---------------------------------------------------------------------------
model Character {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  name      String
  level     Int      @default(1)
  exp       Int      @default(0)
  hp        Int      @default(100)
  maxHp     Int      @default(100) @map("max_hp")
  appearance String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("characters")
}

// ---------------------------------------------------------------------------
// 3. Curriculum & Structure (HSK 3.0 / HSK 2.0 versioned)
// ---------------------------------------------------------------------------
model Curriculum {
  id                      String   @id @default(cuid())
  code                    String   @unique // e.g. "hsk-3.0"
  name                    String   // "HSK 3.0 Standard Course"
  version                 String   // "3.0"
  languageCode            String   @default("zh") @map("language_code")
  translationLanguageCode String   @default("vi") @map("translation_language_code")
  sourceUrl               String?  @map("source_url")
  licenseName             String   @default("Open Attribution License") @map("license_name")
  licenseUrl              String?  @map("license_url")
  status                  String   @default("active")
  createdAt               DateTime @default(now()) @map("created_at")

  levels CurriculumLevel[]

  @@map("curriculums")
}

model CurriculumLevel {
  id             String @id @default(cuid())
  curriculumId   String @map("curriculum_id")
  code           String // e.g. "hsk-3.0-band-1"
  name           String // "Band 1 (Elementary Level 1)"
  sequenceNumber Int    @map("sequence_number")

  curriculum Curriculum             @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  courses    Course[]
  vocabulary CurriculumVocabulary[]

  @@unique([curriculumId, code])
  @@map("curriculum_levels")
}

model Course {
  id                String @id @default(cuid())
  curriculumLevelId String @map("curriculum_level_id")
  title             String
  description       String
  orderIndex        Int    @map("order_index")

  curriculumLevel CurriculumLevel @relation(fields: [curriculumLevelId], references: [id], onDelete: Cascade)
  units           Unit[]

  @@map("courses")
}

model Unit {
  id         String @id @default(cuid())
  courseId   String @map("course_id")
  title      String
  orderIndex Int    @map("order_index")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("units")
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String   @map("unit_id")
  title       String
  description String
  orderIndex  Int      @map("order_index")
  expReward   Int      @default(50) @map("exp_reward")
  goldReward  Int      @default(20) @map("gold_reward")
  createdAt   DateTime @default(now()) @map("created_at")

  unit             Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vocabulary       CurriculumVocabulary[]
  learningSessions LearningSession[]

  @@map("lessons")
}

// ---------------------------------------------------------------------------
// 4. Vocabulary & Rich Linguistic Details
// ---------------------------------------------------------------------------
model Vocabulary {
  id           String   @id @default(cuid())
  simplified   String   // "你好"
  traditional  String?  // "你好"
  audioUrl     String?  @map("audio_url")
  languageCode String   @default("zh") @map("language_code")
  strokeCount  Int?     @map("stroke_count")  // Total stroke count
  strokeOrder String?    @map("stroke_order")   // Stroke order data for HanziWriter
  createdAt    DateTime @default(now()) @map("created_at")

  readings           VocabularyReading[]
  meanings           VocabularyMeaning[]
  examples           VocabularyExample[]
  curriculumEntries  CurriculumVocabulary[]
  learningAnswers    LearningAnswer[]
  vocabularyProgress VocabularyProgress[]
  reviewHistory      ReviewHistory[]
  radicals           VocabularyRadical[]

  @@index([simplified])
  @@map("vocabulary")
}

model VocabularyReading {
  id            String  @id @default(cuid())
  vocabularyId  String  @map("vocabulary_id")
  reading       String  // "nǐ hǎo"
  readingSystem String  @default("pinyin") @map("reading_system")
  isPrimary     Boolean @default(true) @map("is_primary")

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_readings")
}

model VocabularyMeaning {
  id           String  @id @default(cuid())
  vocabularyId String  @map("vocabulary_id")
  languageCode String  @default("vi") @map("language_code")
  meaning      String  // "chào bạn; xin chào"
  partOfSpeech String? @map("part_of_speech") // "greeting", "noun", "verb"

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_meanings")
}

model VocabularyExample {
  id            String @id @default(cuid())
  vocabularyId  String @map("vocabulary_id")
  sentenceZh    String @map("sentence_zh") // "你好！很高兴认识你。"
  sentencePinyin String @map("sentence_pinyin") // "Nǐ hǎo! Hěn gāoxìng rènshí nǐ."
  translationVi String @map("translation_vi") // "Xin chào! Rất vui được gặp bạn."

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([vocabularyId])
  @@map("vocabulary_examples")
}

model CurriculumVocabulary {
  id                String  @id @default(cuid())
  curriculumLevelId String  @map("curriculum_level_id")
  vocabularyId      String  @map("vocabulary_id")
  lessonId          String? @map("lesson_id")
  sequenceNumber    Int     @map("sequence_number")

  curriculumLevel CurriculumLevel @relation(fields: [curriculumLevelId], references: [id], onDelete: Cascade)
  vocabulary      Vocabulary      @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  lesson          Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([curriculumLevelId, vocabularyId])
  @@index([lessonId])
  @@map("curriculum_vocabulary")
}

// ---------------------------------------------------------------------------
// 4b. Radicals (部首 / Bộ thủ) — Kangxi 214 System
// ---------------------------------------------------------------------------
model Radical {
  id          String @id @default(cuid())
  character   String @unique // "亻" (radical character)
  unicode     String @unique // "U+4EBB"
  kangxiNo    Int    @unique @map("kangxi_no") // 1-214 Kangxi number
  strokeCount Int    @map("stroke_count")
  pinyin      String // "rén"
  meaningEn   String @map("meaning_en") // "person"
  meaningVi   String @map("meaning_vi") // "người"
  mnemonic    String? // Memory aid: "Looks like a person walking"
  mnemonicVi  String? @map("mnemonic_vi") // Vietnamese mnemonic
  examples    String? // Common characters using this radical: "你,他,们"
  createdAt   DateTime @default(now()) @map("created_at")

  vocabularyRadicals VocabularyRadical[]

  @@index([kangxiNo])
  @@index([strokeCount])
  @@map("radicals")
}

model VocabularyRadical {
  id           String @id @default(cuid())
  vocabularyId String @map("vocabulary_id")
  radicalId    String @map("radical_id")
  position     String @default("left") // "left" | "right" | "top" | "bottom" | "enclosure" | "whole"
  isPrimary    Boolean @default(false) @map("is_primary") // Main radical (部首) vs component

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  radical    Radical    @relation(fields: [radicalId], references: [id], onDelete: Cascade)

  @@unique([vocabularyId, radicalId])
  @@index([vocabularyId])
  @@index([radicalId])
  @@map("vocabulary_radicals")
}

// ---------------------------------------------------------------------------
// 5. Learning Sessions & Answer History
// ---------------------------------------------------------------------------
model LearningSession {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  lessonId       String?   @map("lesson_id")
  sessionType    String    @map("session_type") // "lesson" | "review" | "practice"
  status         String    @default("in_progress") // "in_progress" | "completed" | "abandoned"
  totalQuestions Int       @default(0) @map("total_questions")
  correctCount   Int       @default(0) @map("correct_count")
  accuracy       Float     @default(0.0)
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  answers LearningAnswer[]

  @@index([userId, status])
  @@map("learning_sessions")
}

model LearningAnswer {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  userId         String   @map("user_id")
  vocabularyId   String   @map("vocabulary_id")
  activityType   String   @map("activity_type") // "flashcard" | "matching" | "quiz" | "radical" | "writing"
  userAnswer     String   @map("user_answer")
  isCorrect      Boolean  @map("is_correct")
  responseTimeMs Int      @default(0) @map("response_time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  session    LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary      @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, vocabularyId])
  @@map("learning_answers")
}

// ---------------------------------------------------------------------------
// 6. Spaced Repetition System (FSRS-aligned scheduler)
// ---------------------------------------------------------------------------
model VocabularyProgress {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  vocabularyId     String    @map("vocabulary_id")
  state            String    @default("new") // "new" | "learning" | "review" | "mastered"
  difficulty       Float     @default(5.0)
  stability        Float     @default(1.0)
  intervalDays     Int       @default(1) @map("interval_days")
  dueAt            DateTime  @default(now()) @map("due_at")
  lastReviewedAt   DateTime? @map("last_reviewed_at")
  totalReviews     Int       @default(0) @map("total_reviews")
  correctReviews   Int       @default(0) @map("correct_reviews")
  incorrectReviews Int       @default(0) @map("incorrect_reviews")
  algorithmVersion String    @default("fsrs-v1") @map("algorithm_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, dueAt])
  @@map("vocabulary_progress")
}

model ReviewHistory {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  vocabularyId   String   @map("vocabulary_id")
  rating         Int      // 1=Again, 2=Hard, 3=Good, 4=Easy
  scheduledDays  Int      @default(1) @map("scheduled_days")
  elapsedDays    Int      @default(0) @map("elapsed_days")
  responseTimeMs Int      @default(0) @map("response_time_ms")
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@index([userId, vocabularyId])
  @@index([userId, reviewedAt])
  @@map("review_history")
}

// ---------------------------------------------------------------------------
// 7. Economy & Server-Authoritative Ledger
// ---------------------------------------------------------------------------
model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  balanceGold Int      @default(0) @map("balance_gold")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  currency        String   @default("gold")
  amount          Int      // Positive = Credit, Negative = Debit
  transactionType String   @map("transaction_type") // "reward_lesson" | "reward_review" | "purchase"
  referenceType   String?  @map("reference_type")   // "lesson" | "session"
  referenceId     String?  @map("reference_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// 7b. Items, Inventory, Equipment & Daily Quests (Phase 2 RPG Foundation)
// ---------------------------------------------------------------------------

model Item {
  id          String         @id @default(cuid())
  code        String         @unique // e.g. "item_bamboo_brush", "item_silk_robe"
  name        String         // "Bút Lông Trúc Lâm (Bamboo Brush)"
  description String
  itemType String @default("EQUIPMENT") @map("item_type")
  slot String?
  rarity String @default("COMMON")
  priceGold   Int            @default(50) @map("price_gold")
  icon        String         @default("Package")
  stats String?          // { hpBonus: 10, bonusExpPercent: 5 }
  isShopItem  Boolean        @default(true) @map("is_shop_item")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]

  @@map("items")
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  itemId     String   @map("item_id")
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false) @map("is_equipped")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, isEquipped])
  @@map("inventory_items")
}

model Quest {
  id          String          @id @default(cuid())
  code        String          @unique // e.g. "daily_complete_1_lesson"
  title       String          // "Vượt ải đầu ngày"
  description String          // "Hoàn thành 1 bài học tiếng Trung bất kỳ"
  category String @default("DAILY")
  targetType String @map("target_type")
  targetCount Int             @default(1) @map("target_count")
  rewardGold  Int             @default(50) @map("reward_gold")
  rewardExp   Int             @default(30) @map("reward_exp")
  icon        String          @default("Scroll")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  questId      String    @map("quest_id")
  currentCount Int       @default(0) @map("current_count")
  isCompleted  Boolean   @default(false) @map("is_completed")
  isClaimed    Boolean   @default(false) @map("is_claimed")
  resetDate    String    @map("reset_date") // YYYY-MM-DD for daily quests
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, resetDate])
  @@index([userId, resetDate])
  @@map("user_quests")
}

// ---------------------------------------------------------------------------
// 8. Audio Infrastructure & Voice System (Audio_system.md)
// ---------------------------------------------------------------------------

model VoiceProfile {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "vp_learning_standard", "vp_village_guide"
  name            String   // "Giáo Viên Chuẩn Phổ Thông"
  description     String?
  gender          String   @default("female") // "female" | "male" | "neutral"
  role            String   @default("learning") // "learning" | "village_guide" | "shopkeeper" | "storyteller"
  languageCode    String   @default("zh-CN") @map("language_code")
  provider        String   @default("cosyvoice") // "cosyvoice" | "edge-tts" | "mock"
  providerVoiceId String   @map("provider_voice_id") // Voice identifier within provider
  pitch           Float    @default(1.0)
  speed           Float    @default(0.85) // Tone-clarified rate for Mandarin learners
  isSystem        Boolean  @default(true) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  assets AudioAsset[]
  jobs   AudioGenerationJob[]

  @@map("voice_profiles")
}

model AudioAsset {
  id                String                 @id @default(cuid())
  contentType String       @map("content_type")
  contentId         String                 @map("content_id")
  language          String                 @default("zh-CN")
  sourceText        String                 @map("source_text")
  pinyin            String?
  voiceProfileId    String                 @map("voice_profile_id")
  provider          String                 @default("cosyvoice")
  storageKey        String                 @unique @map("storage_key")
  audioFormat       String                 @default("mp3") @map("audio_format")
  durationMs        Int                    @default(0) @map("duration_ms")
  fileSizeBytes     Int                    @default(0) @map("file_size_bytes")
  checksum          String                 @default("") // SHA-256 hash
  version           Int                    @default(1)
  generationParams String?                  @map("generation_params")
  reviewStatus String @default("NEEDS_REVIEW") @map("review_status")
  publicationStatus String @default("DRAFT") @map("publication_status")
  isPrimary         Boolean                @default(false) @map("is_primary")
  reviewedBy        String?                @map("reviewed_by")
  reviewedAt        DateTime?              @map("reviewed_at")
  publishedAt       DateTime?              @map("published_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  voiceProfile VoiceProfile         @relation(fields: [voiceProfileId], references: [id], onDelete: Restrict)
  jobs         AudioGenerationJob[]

  @@index([contentType, contentId, publicationStatus])
  @@index([contentType, contentId, isPrimary])
  @@index([voiceProfileId])
  @@map("audio_assets")
}

model AudioGenerationJob {
  id             String           @id @default(cuid())
  contentType String @map("content_type")
  contentId      String           @map("content_id")
  sourceText     String           @map("source_text")
  pinyin         String?
  voiceProfileId String           @map("voice_profile_id")
  provider       String           @default("cosyvoice")
  status String @default("PENDING")
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3) @map("max_attempts")
  errorMessage   String?          @map("error_message")
  resultAssetId  String?          @map("result_asset_id")
  idempotencyKey String           @unique @map("idempotency_key")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  voiceProfile VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Restrict)
  resultAsset  AudioAsset?  @relation(fields: [resultAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contentType, contentId])
  @@map("audio_generation_jobs")
}

// ---------------------------------------------------------------------------
// 9. World Regions & Server-Authoritative Combat (Phase 3 Adventure World)
// ---------------------------------------------------------------------------

model Region {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "region_novice_village", "region_bamboo_grove"
  name          String   // "Làng Tân Khởi (Novice Village)"
  description   String
  requiredLevel Int      @default(1) @map("required_level")
  isUnlocked    Boolean  @default(true) @map("is_unlocked")
  orderIndex    Int      @default(1) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("regions")
}

model CombatSession {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  enemyName      String      @map("enemy_name")
  enemyHp        Int         @map("enemy_hp")
  enemyMaxHp     Int         @map("enemy_max_hp")
  enemyAtk       Int         @default(15) @map("enemy_atk")
  playerHp       Int         @map("player_hp")
  playerMaxHp    Int         @map("player_max_hp")
  status String @default("IN_PROGRESS")
  currentTurn    Int         @default(1) @map("current_turn")
  turnQuestions String        @map("turn_questions") // Stored question list with correct answers for validation
  expReward      Int         @default(40) @map("exp_reward")
  goldReward     Int         @default(25) @map("gold_reward")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("combat_sessions")
}

// ---------------------------------------------------------------------------
// 10. Chakra Learning Milestones (7-Chakra Proficiency Model)
// ---------------------------------------------------------------------------

model UserChakraProgress {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  chakraTier         Int       @map("chakra_tier") // 1: Muladhara, 2: Svadhisthana, ... 7: Sahasrara
  progressPercent    Float     @default(0.0) @map("progress_percent") // 0.0 - 100.0
  retainedVocabCount Int       @default(0) @map("retained_vocab_count") // Words with stability >= threshold
  targetVocabCount   Int       @default(50) @map("target_vocab_count") // Target threshold for this tier
  avgStability       Float     @default(0.0) @map("avg_stability") // Average FSRS stability across words
  listeningAccuracy  Float     @default(0.0) @map("listening_accuracy") // Accuracy in listening activities
  readingAccuracy    Float     @default(0.0) @map("reading_accuracy") // Accuracy in reading/matching activities
  writingAccuracy    Float     @default(0.0) @map("writing_accuracy") // Accuracy in writing/stroke activities
  characterAccuracy  Float     @default(0.0) @map("character_accuracy") // Accuracy in radical/hanzi quiz activities
  isUnlocked         Boolean   @default(false) @map("is_unlocked")
  unlockedAt         DateTime? @map("unlocked_at")
  rewardClaimed      Boolean   @default(false) @map("reward_claimed")
  rewardClaimedAt    DateTime? @map("reward_claimed_at")
  bottleneckSkill    String?   @map("bottleneck_skill") // "listening" | "reading" | "writing" | "character" | "retention"
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chakraTier])
  @@index([userId, chakraTier])
  @@map("user_chakra_progress")
}
